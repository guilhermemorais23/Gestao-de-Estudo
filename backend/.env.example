# Copie para backend/.env e preencha
SECRET_KEY=troque-por-uma-frase-grande-e-aleatoria
# Chave da Google Places API (New) — console.cloud.google.com
GOOGLE_MAPS_API_KEY=
# 1 = qualquer pessoa pode criar conta. 0 = só o primeiro usuário (padrão)
PERMITIR_CADASTRO=0
# Chave da API da Anthropic (console.anthropic.com) — gera os textos da prévia com IA
ANTHROPIC_API_KEY=
# Modelo usado para os textos (padrão: claude-haiku-4-5)
IA_MODELO=claude-haiku-4-5
